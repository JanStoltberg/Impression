---
import Layout from '../../layouts/Layout.astro';
import { listBriefingDates } from '../../lib/data.js';

const dates = listBriefingDates();
const base = import.meta.env.BASE_URL;
---

<Layout title="Archiv — Impression">
  <section class="hero hero--compact">
    <p class="hero__eyebrow">Archiv</p>
    <h1 class="hero__date">Alle Briefings</h1>
  </section>

  {dates.length === 0 && <p class="empty">Noch keine Briefings vorhanden.</p>}

  <ul class="archive-list">
    {dates.map((date) => (
      <li>
        <a href={`${base}archiv/${date}/`}>
          {new Date(date).toLocaleDateString('de-DE', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </a>
      </li>
    ))}
  </ul>
</Layout>
