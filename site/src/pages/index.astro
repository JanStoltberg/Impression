---
import Layout from '../layouts/Layout.astro';
import {
  loadLatestBriefing,
  groupByRegionAndTopic,
  getSummary,
  REGION_LABELS,
  TOPIC_LABELS,
} from '../lib/data.js';

const briefing = loadLatestBriefing();
const groups = briefing ? groupByRegionAndTopic(briefing.items) : {};

const dateLabel = briefing
  ? new Date(briefing.date).toLocaleDateString('de-DE', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// Manuell gepflegter Einordnungstext fuers heutige Briefing. Leerer String
// blendet die Box aus.
const introText = 'Hallo zusammen, hier kommt das Morning-Briefing zum Mittwoch!';
---

<Layout title="Impression — Heutiges Briefing">
  <section class="hero">
    <p class="hero__eyebrow">Morning Briefing</p>
    <h1 class="hero__date">{dateLabel ?? 'Noch kein Briefing vorhanden'}</h1>
  </section>

  {introText && (
    <section class="intro-box">
      <p class="intro-box__label">Einordnung</p>
      <p class="intro-box__text">{introText}</p>
    </section>
  )}

  {!briefing && (
    <p class="empty">
      Es liegt noch kein Briefing in <code>data/briefings/</code>. Erst
      <code>ingest.py</code> und dann <code>curate.py</code> laufen lassen.
    </p>
  )}

  {briefing && (
    <nav class="toc" aria-label="Inhaltsverzeichnis">
      <p class="toc__label">Inhalt</p>
      <div class="toc__groups">
        {Object.entries(groups).map(([region, topics]) => (
          <div class="toc__group">
            <p class="toc__region">{REGION_LABELS[region] ?? region}</p>
            <ul class="toc__list">
              {Object.entries(topics).map(([topic]) => (
                <li>
                  <a href={`#${region}-${topic}`}>{TOPIC_LABELS[topic] ?? topic}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  )}

  {Object.entries(groups).map(([region, topics]) => (
    <section class="region">
      <h2 class="region__title">{REGION_LABELS[region] ?? region}</h2>
      {Object.entries(topics).map(([topic, items]) => (
        <div class="topic" id={`${region}-${topic}`}>
          <h3 class="topic__title">{TOPIC_LABELS[topic] ?? topic}</h3>
          <ol class="items">
            {items.map((item) => (
              <li class="item">
                <a class="item__title" href={item.url} target="_blank" rel="noopener">
                  {item.title}
                </a>
                {getSummary(item) && <p class="item__summary">{getSummary(item)}</p>}
                <p class="item__meta">
                  {item.source}
                  {item.published
                    ? ` · ${new Date(item.published).toLocaleDateString('de-DE')}`
                    : ''}
                </p>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  ))}
</Layout>
