---
const { title = 'Impression' } = Astro.props;
const base = import.meta.env.BASE_URL; // beginnt und endet immer mit "/"
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <header class="masthead">
      <a href={base} class="masthead__title">Impression</a>
      <nav class="masthead__nav">
        <a href={base}>Heute</a>
        <a href={`${base}archiv/`}>Archiv</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      Kuratiert aus HORIZONT, W&amp;V, ADZINE, Digiday, AdExchanger, Adweek u.&nbsp;a.
      — automatisch generiert, kein redaktionelles Original. Immer zur Quelle verlinkt.
    </footer>
  </body>
</html>
